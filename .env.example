# ==========================================
# FinMate Phase 0 — Environment Configuration
# ==========================================

# Application
APP_NAME=FinMate
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production-finmate-2026

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/finmate_db

# Fallback SQLite Database URL (Optional for offline local dev/testing)
# SQLITE_DATABASE_URL=sqlite:///./finmate.db

# CORS Allowed Origins (JSON array or comma-separated strings)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Logging
LOG_LEVEL=INFO

# ==========================================
# Phase 3 AI Intelligence Configuration
# ==========================================
# Options: mock, openai, gemini (default: mock for zero-cost offline development)
AI_PROVIDER=mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Options: local, openai (default: local TF-IDF cosine embeddings)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=tfidf-sublinear
VECTOR_STORE=in_memory
